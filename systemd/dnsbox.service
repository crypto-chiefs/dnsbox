[Unit]
Description=DNSBox DNS and HTTPS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Create this service account and grant it ownership of /var/lib/dnsbox first.
User=dnsbox
Group=dnsbox
ExecStart=/usr/local/bin/dnsboxd
EnvironmentFile=/etc/dnsbox/dnsbox.env
WorkingDirectory=/var/lib/dnsbox
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dnsbox

[Install]
WantedBy=multi-user.target